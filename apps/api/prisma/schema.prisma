generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. Authentication & Security
// -----------------------------------------------------------------------------

model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         String         @default("SUPER_ADMIN")
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  auditLogs    AuditLog[]

  @@index([email])
}

model AdminSession {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// 2. Personal Profile & Academic Journey
// -----------------------------------------------------------------------------

model Profile {
  id                String   @id @default("default")
  name              String
  headline          String
  tagline           String
  shortBio          String
  fullBio           String
  avatarUrl         String?
  bannerUrl         String?
  resumeUrl         String?
  location          String
  email             String
  phone             String?
  availability      String   @default("OPEN_TO_WORK")
  currentStatus     String
  yearsOfExperience Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Education {
  id             String   @id @default(uuid())
  degree         String
  fieldOfStudy   String
  institution    String
  academicStatus String
  startYear      Int
  endYear        Int?
  isCurrent      Boolean  @default(false)
  grade          String?
  description    String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([order])
}

// -----------------------------------------------------------------------------
// 3. Skills & Categories
// -----------------------------------------------------------------------------

model SkillCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skills    Skill[]

  @@index([order])
}

model Skill {
  id                  String              @id @default(uuid())
  name                String              @unique
  slug                String              @unique
  categoryId          String
  proficiency         Int                 @default(80)
  icon                String?
  featured            Boolean             @default(false)
  order               Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  category            SkillCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  projectTechnologies ProjectTechnology[]

  @@index([categoryId])
  @@index([order])
  @@index([featured])
}

// -----------------------------------------------------------------------------
// 4. Projects & Showcase
// -----------------------------------------------------------------------------

model Project {
  id           String              @id @default(uuid())
  slug         String              @unique
  title        String
  subtitle     String
  description  String
  content      String?
  category     String              @default("FULL_STACK")
  status       String              @default("COMPLETED")
  featured     Boolean             @default(false)
  order        Int                 @default(0)
  published    Boolean             @default(true)
  liveUrl      String?
  githubUrl    String?
  demoVideoUrl String?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  technologies ProjectTechnology[]
  images       ProjectImage[]

  @@index([slug])
  @@index([category])
  @@index([featured])
  @@index([order])
  @@index([published])
}

model ProjectTechnology {
  id        String   @id @default(uuid())
  projectId String
  skillId   String?
  name      String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill?   @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([skillId])
}

model ProjectImage {
  id          String   @id @default(uuid())
  projectId   String
  url         String
  alt         String?
  caption     String?
  isThumbnail Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([order])
}

// -----------------------------------------------------------------------------
// 5. Professional Experience & Credentials
// -----------------------------------------------------------------------------

model Experience {
  id             String    @id @default(uuid())
  company        String
  role           String
  employmentType String    @default("FULL_TIME")
  location       String?
  locationType   String    @default("REMOTE")
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  description    String
  achievements   String?
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([order])
}

model Certification {
  id                 String    @id @default(uuid())
  title              String
  issuer             String
  issueDate          DateTime
  expiryDate         DateTime?
  credentialId       String?
  credentialUrl      String?
  certificateFileUrl String?
  order              Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([order])
}

model Achievement {
  id           String   @id @default(uuid())
  title        String
  organization String?
  date         DateTime
  description  String
  badgeUrl     String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
}

// -----------------------------------------------------------------------------
// 6. Resume & Social Links
// -----------------------------------------------------------------------------

model Resume {
  id        String   @id @default(uuid())
  title     String
  version   String
  fileUrl   String
  fileSize  Int?
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPrimary])
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  url       String
  username  String?
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}

// -----------------------------------------------------------------------------
// 7. Contact Messages
// -----------------------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("UNREAD")
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// 7b. Blog & Articles CMS
// -----------------------------------------------------------------------------

model BlogPost {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  summary        String
  content        String
  featuredImage  String?
  tags           String[]  @default([])
  published      Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  viewCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
  @@index([published])
  @@index([publishedAt])
}

// -----------------------------------------------------------------------------
// 8. Website Configuration & SEO
// -----------------------------------------------------------------------------

model WebsiteSettings {
  id            String   @id @default("default")
  siteName      String   @default("Amit Chauhan")
  siteTagline   String   @default("Personal Portfolio & CMS")
  contactEmail  String   @default("contact@amitchauhan.me")
  isMaintenance Boolean  @default(false)
  allowMessages Boolean  @default(true)
  theme         String   @default("dark")
  updatedAt     DateTime @updatedAt
}

model SEOSettings {
  id              String   @id @default("default")
  metaTitle       String   @default("Amit Chauhan — Senior Full-Stack Architect & AI Engineer")
  metaDescription String   @default("Portfolio and project showcase of Amit Chauhan, Computer Engineering candidate specializing in AI, ML, and resilient full-stack systems.")
  metaKeywords    String   @default("Amit Chauhan, Full Stack Developer, AI, Machine Learning, Portfolio, Computer Engineering, React, Node.js")
  ogImage         String?
  twitterCard     String   @default("summary_large_image")
  canonicalUrl    String   @default("https://amitchauhan.me")
  robots          String   @default("index, follow")
  updatedAt       DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 9. Analytics & Audit Logs
// -----------------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  path      String
  referrer  String?
  userAgent String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model AuditLog {
  id        String     @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime   @default(now())
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

