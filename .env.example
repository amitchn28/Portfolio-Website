# ==============================================================================
# AMIT CHAUHAN PORTFOLIO & ADMIN CMS - MONOREPO ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=amit_portfolio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_postgres_password_here@127.0.0.1:5432/amit_portfolio?schema=public

# Optional Docker Management
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password
PGADMIN_PORT=5050

# Backend API (Express)
API_PORT=5000
NODE_ENV=development
CORS_ORIGIN_WEB=http://localhost:3000
CORS_ORIGIN_ADMIN=http://localhost:3001
JWT_SECRET=super-secret-development-jwt-key-replace-in-production
ADMIN_EMAIL=amitchn28@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Amit Chauhan

# Owner & Notification Email Configuration
OWNER_EMAIL=amitchn28@gmail.com

# Email Service Integration (Resend preferred, SMTP alternative)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM="Amit Chauhan Portfolio" <notifications@yourdomain.com>

# Storage Provider Configuration (local for dev, s3/cloudinary for production)
STORAGE_PROVIDER=local

# Public Web Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SITE_URL=http://localhost:3000

# Admin Dashboard Frontend (Vite)
VITE_ADMIN_API_URL=http://localhost:5000/api
VITE_ADMIN_SITE_URL=http://localhost:3001
